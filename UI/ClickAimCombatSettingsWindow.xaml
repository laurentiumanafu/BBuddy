<mah:MetroWindow x:Class="CopilotBuddy.UI.ClickAimCombatSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        x:Name="Window"
        Title="Combat settings"
        Width="560" Height="560"
        MinWidth="560" MinHeight="520"
        TitleCharacterCasing="Normal"
        Background="{DynamicResource WindowBackgroundBrush}"
        GlowBrush="{DynamicResource MahApps.Brushes.Accent}">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TabControl Grid.Row="0" Margin="0,0,0,8">
        <!-- ===================================================== numbers ============ -->
        <TabItem Header="Eating and drinking">
            <Grid Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- 0 intro       -->
                    <RowDefinition Height="Auto"/>  <!-- 1 heal        -->
                    <RowDefinition Height="Auto"/>  <!-- 2 heal power  -->
                    <RowDefinition Height="Auto"/>  <!-- 3 eat         -->
                    <RowDefinition Height="Auto"/>  <!-- 4 drink       -->
                    <RowDefinition Height="Auto"/>  <!-- 5 dot         -->
                    <RowDefinition Height="Auto"/>  <!-- 6 dot secs    -->
                    <RowDefinition Height="Auto"/>  <!-- 7 buffs       -->
                    <RowDefinition Height="Auto"/>  <!-- 8 food slot   -->
                    <RowDefinition Height="Auto"/>  <!-- 9 drink slot  -->
                    <RowDefinition Height="Auto"/>  <!-- 10 rest ms    -->
                    <RowDefinition Height="Auto"/>  <!-- 11 file       -->
                    <RowDefinition Height="*"/>     <!-- 12 spacer     -->
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" TextWrapping="Wrap" Margin="0,0,0,12"
                           Text="The grind loop reads these numbers at the start of every run. A percentage of 0 turns that rule off."/>

                <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,8"
                           Text="Heal myself at or below (percent health)"/>
                <TextBox x:Name="txtHeal" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,8"
                           Text="...but only while power is at least (percent)"/>
                <TextBox x:Name="txtHealMana" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"
                         ToolTip="A heal costs mana. Below this line the bot does not press it: it fights with auto-attack and whatever still casts."/>

                <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,8"
                           Text="Eat at or below (percent health)"/>
                <TextBox x:Name="txtEat" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,8"
                           Text="Drink at or below (percent mana)"/>
                <TextBox x:Name="txtDrink" Grid.Row="4" Grid.Column="1" Margin="0,0,0,8"/>

                <CheckBox x:Name="chkDot" Grid.Row="5" Grid.ColumnSpan="2" Margin="0,8,0,4"
                          Content="Use damage-over-time spells (Moonfire, Corruption, Serpent Sting ...)"/>

                <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,8"
                           Text="Refresh a damage-over-time spell after (seconds)"/>
                <TextBox x:Name="txtDotSeconds" Grid.Row="6" Grid.Column="1" Margin="0,0,0,8"/>

                <CheckBox x:Name="chkBuffs" Grid.Row="7" Grid.ColumnSpan="2" Margin="0,4,0,12"
                          Content="Apply self-buffs when the run starts"/>

                <TextBlock Grid.Row="8" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,8"
                           Text="Food slot (0 = find it on the bar)"/>
                <TextBox x:Name="txtFoodSlot" Grid.Row="8" Grid.Column="1" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="9" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,8"
                           Text="Drink slot (0 = find it on the bar)"/>
                <TextBox x:Name="txtDrinkSlot" Grid.Row="9" Grid.Column="1" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="10" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,8"
                           Text="Rest for at most (milliseconds)"/>
                <TextBox x:Name="txtRestMs" Grid.Row="10" Grid.Column="1" Margin="0,0,0,8"/>

                <TextBlock x:Name="lblFile" Grid.Row="11" Grid.ColumnSpan="2" TextWrapping="Wrap"
                           Margin="0,8,0,0" FontSize="11" Opacity="0.7"/>

                <TextBlock Grid.Row="12" Grid.ColumnSpan="2" TextWrapping="Wrap" Margin="0,12,0,0"
                           VerticalAlignment="Top" FontSize="11" Opacity="0.7"
                           Text="The character eats and drinks between fights, out of combat: it stops moving, presses the food or drink key, and waits."/>
            </Grid>
        </TabItem>

        <!-- ===================================================== spells ============= -->
        <TabItem Header="Spells">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="What each spell on the action bar is for. The bot knows the 3.3.5a spellbook by name; a rank from a private server, a spell it does not recognise, or one you would rather it never pressed can be set here."/>

                <ListView x:Name="lstSpells" Grid.Row="1" Margin="0,0,0,8"
                          SelectionMode="Single" SelectionChanged="lstSpells_SelectionChanged">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Slot" Width="45" DisplayMemberBinding="{Binding Slot}"/>
                            <GridViewColumn Header="Key" Width="45" DisplayMemberBinding="{Binding Key}"/>
                            <GridViewColumn Header="Spell" Width="230" DisplayMemberBinding="{Binding Spell}"/>
                            <GridViewColumn Header="Role" Width="100" DisplayMemberBinding="{Binding Role}"/>
                            <GridViewColumn Header="Range" Width="80" DisplayMemberBinding="{Binding Range}"/>
                            <GridViewColumn Header="Set by" Width="70" DisplayMemberBinding="{Binding Source}"/>
                        </GridView>
                    </ListView.View>
                </ListView>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Role:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="cmbRole" Width="130" SelectedIndex="0">
                        <ComboBoxItem Content="(built-in)"/>
                        <ComboBoxItem Content="Damage"/>
                        <ComboBoxItem Content="Dot"/>
                        <ComboBoxItem Content="Heal"/>
                        <ComboBoxItem Content="Buff"/>
                        <ComboBoxItem Content="Attack"/>
                        <ComboBoxItem Content="Utility"/>
                        <ComboBoxItem Content="Ignore"/>
                    </ComboBox>
                    <Button Content="Apply to selected" Width="120" Height="24" Margin="8,0,0,0"
                            Click="btnApplyRole_Click"/>
                    <Button Content="Refresh" Width="80" Height="24" Margin="8,0,0,0"
                            Click="btnRefreshSpells_Click"/>
                </StackPanel>

                <TextBlock x:Name="lblSpells" Grid.Row="3" TextWrapping="Wrap" FontSize="11"
                           Opacity="0.7" Margin="0,0,0,4"/>

                <TextBlock Grid.Row="4" TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                           Text="&quot;(built-in)&quot; removes your setting and goes back to the name table. &quot;Ignore&quot; means the bot never presses that spell."/>
            </Grid>
        </TabItem>
        <!-- ===================================================== selling ============ -->
        <TabItem Header="Selling">
            <Grid Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- 0 intro         -->
                    <RowDefinition Height="Auto"/>  <!-- 1 auto sell     -->
                    <RowDefinition Height="Auto"/>  <!-- 2 after loots   -->
                    <RowDefinition Height="Auto"/>  <!-- 3 merchant wait -->
                    <RowDefinition Height="Auto"/>  <!-- 4 vendor search -->
                    <RowDefinition Height="Auto"/>  <!-- 5 point buttons -->
                    <RowDefinition Height="Auto"/>  <!-- 6 record buttons-->
                    <RowDefinition Height="Auto"/>  <!-- 7 note          -->
                    <RowDefinition Height="*"/>     <!-- 8 plan          -->
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" TextWrapping="Wrap" Margin="0,0,0,10"
                           Text="The bags cannot be counted on this build, so the bot counts what it has looted: it walks to a vendor after that many bodies. The place to walk to is captured where the character stands, and the clicks that sell the loot are recorded once, here."/>

                <CheckBox x:Name="chkAutoSell" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,8"
                          Content="Walk to the vendor and sell when the bags are due"/>

                <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,8"
                           Text="...after this many looted bodies (0 = only with the button)"/>
                <TextBox x:Name="txtSellAfter" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,8"
                           Text="Wait for the merchant window (milliseconds)"/>
                <TextBox x:Name="txtVendorWait" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,8"
                           Text="Look for the vendor NPC within (yards)"/>
                <TextBox x:Name="txtVendorSearch" Grid.Row="4" Grid.Column="1" Margin="0,0,0,8"/>

                <WrapPanel Grid.Row="5" Grid.ColumnSpan="2" Margin="0,6,0,4">
                    <Button Content="Add vendor here" Height="24" Padding="8,0" Click="btnVendorAdd_Click"
                            ToolTip="Stand at the vendor in town and press this: that spot becomes the place the bot walks to when the bags are full."/>
                    <Button Content="Sell now" Height="24" Padding="8,0" Margin="8,0,0,0" Click="btnVendorSellNow_Click"
                            ToolTip="A running grind loop goes to the vendor as soon as nothing is attacking."/>
                    <Button Content="Clear steps" Height="24" Padding="8,0" Margin="8,0,0,0" Click="btnVendorClearSteps_Click"/>
                </WrapPanel>

                <WrapPanel Grid.Row="6" Grid.ColumnSpan="2" Margin="0,0,0,4">
                    <Button Content="Left click (3 s)" Height="24" Padding="8,0" Click="btnVendorRecordLeft_Click"
                            ToolTip="Press it, then put the cursor on the thing to click inside three seconds. The merchant window's own options (e.g. Browse goods) are left clicks."/>
                    <Button Content="Right click (3 s)" Height="24" Padding="8,0" Margin="8,0,0,0" Click="btnVendorRecordRight_Click"
                            ToolTip="Press it, then put the cursor on an item in the bags inside three seconds: while the merchant window is open, a right-click on an item sells it."/>
                    <Button Content="Bags key (B)" Height="24" Padding="8,0" Margin="8,0,0,0" Click="btnVendorBagsKey_Click"
                            ToolTip="Records a press of B, which opens the backpack. It toggles: record it a second time at the end of the plan to close the bags."/>
                </WrapPanel>

                <TextBlock x:Name="lblVendorNote" Grid.Row="7" Grid.ColumnSpan="2" TextWrapping="Wrap"
                           Margin="0,2,0,6" FontSize="11" Opacity="0.85"/>

                <TextBlock x:Name="lblVendorPlan" Grid.Row="8" Grid.ColumnSpan="2" TextWrapping="Wrap"
                           FontSize="11" Opacity="0.75" VerticalAlignment="Top"/>
            </Grid>
        </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Defaults" Width="90" Height="26" Margin="0,0,8,0"
                    Click="btnDefaults_Click"/>
            <Button Content="Save" Width="90" Height="26" Margin="0,0,8,0"
                    IsDefault="True" Click="btnSave_Click"/>
            <Button Content="Cancel" Width="90" Height="26"
                    IsCancel="True" Click="btnCancel_Click"/>
        </StackPanel>
    </Grid>
</mah:MetroWindow>
