+  PSet $b 0x60 ([uint64]$script:trampMode)
+  PSet $b 0x78 ($script:base + [uint64]$fnRva)
+  PSet $b 0x80 ($script:base + [uint64]0x471BC20)
+  PSet $b 0x88 ($script:base + [uint64]0x471B5C0)
+  PSet $b 0x98 ([uint64]0xDEAD)
+  return , $b
