+if ($script:stuck -or -not $callOk -or $script:startSec -gt 8) {
+  Say '[S] skipped: no call has completed yet'
+} else {
+  $i = 0
+  foreach ($c in $calls) {
+    $i++
+    $total = $i
+    if ($script:stuck) { Say ('[S' + $i + '] skipped - a payload thread is wedged, restart the client'); break }
