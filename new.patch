+  @{ n = 'MoveForwardStart'; str = 0x5071350; hint = 0x58CF320 },
+  @{ n = 'GetActionInfo';    str = 0x512BF08; hint = 0x590CB20 }
+)
+foreach ($an in $anchors) {
