+# ---------------------------------------------------------------- [2] remote-thread bridge
+$rtStage = [uint64]0
+if ($SkipBridge) {
+  Say ''
+  Say '== [2] bridge skipped by -SkipBridge =='
+} elseif (-not $script:execOk) {
+  Say ''
+  Say '== [2] bridge skipped: canary failed =='
+} elseif (-not $rtProof -and -not $ForceBridge) {
