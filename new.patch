+} catch {
+  Write-Output ("[DUMP] could not write {0}: {1}" -f $codePath, $_.Exception.Message)
+}
+if ($null -ne $peOrig) { try { $peOrig.fs.Close() } catch { } }
+[void][H33]::CloseHandle($hProc)
