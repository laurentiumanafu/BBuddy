         catch (Exception ex) { Logging.Write("[Gather] hover self-test threw: " + ex.Message); }
 
diff --git a/Styx/Logic/Pathing/ClickAim/GatherRunner.cs b/Styx/Logic/Pathing/ClickAim/GatherRunner.cs
index ce92ca0..c4c791e 100644
--- a/Styx/Logic/Pathing/ClickAim/GatherRunner.cs
+++ b/Styx/Logic/Pathing/ClickAim/GatherRunner.cs
@@ -286,6 +286,58 @@ internal static class GatherRunner
         finally { RouteRunner.RequireMeshDuringSession = false; RouteRunner.PollInterruptDuringWalk = false; RouteRunner.ShouldInterrupt = null; }
     }
 
+    /// <summary>
+    /// A hotspot leg failed. Try up to <see cref="MeshRelocate.Attempts"/> other mesh-valid
+    /// locations within <see cref="MeshRelocate.RadiusYd"/> of the character: walk to each over
+    /// the mesh and, once there, ask for the hotspot again from the new position.
+    /// Returns true when the hotspot was reached. On false the caller checks stop, interruption
+    /// and what to do next; <see cref="RouteRunner.LastRunInterrupted"/> is left as the walk set it.
+    /// </summary>
+    private static bool RelocateAndRetry(ClickAimMover mover, RoutePoint original)
+    {
+        var tried = new List<RoutePoint>();
+        Logging.Write(string.Format(CultureInfo.InvariantCulture,
+            "[Gather] could not reach ({0:F1}, {1:F1}); trying up to {2} other mesh locations within {3:F0} yd "
+            + "of the character before giving up", original.X, original.Y, MeshRelocate.Attempts, MeshRelocate.RadiusYd));
+
+        for (int attempt = 1; attempt <= MeshRelocate.Attempts; attempt++)
+        {
+            if (_stop || ClickAimAbort.Requested || !MapStillCurrent()) return false;
+            if (!MeshRelocate.TryPick(_sessionMap, tried, IsBlackspot, out RoutePoint alternate))
+            {
+                Logging.Write("[Gather] relocation " + attempt + "/" + MeshRelocate.Attempts
+                    + ": the mesh offers no further reachable location");
+                return false;
+            }
+            tried.Add(alternate);
+
+            Logging.Write(string.Format(CultureInfo.InvariantCulture,
+                "[Gather] relocation {0}/{1}: walking to ({2:F1}, {3:F1}) over the mesh",
+                attempt, MeshRelocate.Attempts, alternate.X, alternate.Y));
+            bool there = Walk(mover, alternate, true);
+            if (_stop || ClickAimAbort.Requested || RouteRunner.LastRunInterrupted) return false;
+            if (!there)
+            {
+                Logging.Write("[Gather] relocation " + attempt + "/" + MeshRelocate.Attempts
+                    + ": could not get there; trying another location");
+                continue;
+            }
+
+            Logging.Write(string.Format(CultureInfo.InvariantCulture,
+                "[Gather] relocation {0}/{1}: arrived; asking for ({2:F1}, {3:F1}) again from here",
+                attempt, MeshRelocate.Attempts, original.X, original.Y));
+            if (Walk(mover, original, true))
+            {
+                Logging.Write("[Gather] reached the hotspot after relocation " + attempt + "/" + MeshRelocate.Attempts);
+                return true;
+            }
+            if (_stop || ClickAimAbort.Requested || RouteRunner.LastRunInterrupted) return false;
+        }
+
+        Logging.Write("[Gather] all " + MeshRelocate.Attempts + " alternate mesh locations were tried without reaching the hotspot");
+        return false;
+    }
+
     // No movement, turns, stop-key taps or extra clicks while a cast may be running.
     // A resource remaining in the pool can need another hit, or the attempt can have
     // failed; neither proves success. Bound attempts and revisit rather than spin forever.
@@ -625,6 +677,21 @@ internal static class GatherRunner
                     bool walked = Walk(mover, next, true);
                     if (_stop || ClickAimAbort.Requested) break;
                     if (RouteRunner.LastRunInterrupted) { fastHotspots = 0; continue; }
+                    if (!walked)
+                    {
+                        // Same leg from the same stuck spot is not worth a second try (18:11 run:
+                        // three identical failures, then stop). Stand somewhere else on the mesh
+                        // and approach again before giving up.
+                        walked = RelocateAndRetry(mover, next);
+                        if (_stop || ClickAimAbort.Requested) break;
+                        if (RouteRunner.LastRunInterrupted) { fastHotspots = 0; continue; }
+                        if (!walked && roam == null)
+                        {
+                            Logging.Write("[Gather] hotspot unreachable even after " + MeshRelocate.Attempts
+                                + " alternate mesh locations; stopping");
+                            break;
+                        }
+                    }
                     if (walked)
                     {
                         if (roam == null) index = (index + 1) % points.Count;
diff --git a/Styx/Logic/Pathing/ClickAim/MeshRelocate.cs b/Styx/Logic/Pathing/ClickAim/MeshRelocate.cs
new file mode 100644
index 0000000..8e9c54f
--- /dev/null
+++ b/Styx/Logic/Pathing/ClickAim/MeshRelocate.cs
@@ -0,0 +1,159 @@
+using System;
+using System.Collections.Generic;
+using System.Globalization;
+using System.Numerics;
+using Styx.Helpers;
+
+namespace Styx.Logic.Pathing;
+
+/// <summary>
+/// Picks somewhere else to stand when a hotspot leg failed.
+///
+/// The 18:11-18:13 run is the reason this exists: the character got within 16.5 yd of a
+/// hotspot, every key-steered attempt stalled, every sidestep was refused because the short
+/// segment hit the edge of the mesh (ray hit 0.25 / 0), and after three identical failures from
+/// the same spot the gatherer stopped. Asking for the same leg from the same place a third time
+/// is not information. Standing somewhere else on the mesh and approaching again from a
+/// different direction is what a person does.
+///
+/// Every candidate is a point the mesh itself produced (Detour's random-point query, connected
+/// to where the character stands), snapped back onto a polygon, in a safe area type, outside the
+/// profile's blackspots, and reachable by a complete validated mesh path. Candidates are
+/// ranked by how far they are from the places already tried, so five attempts go in five
+/// different directions rather than five neighbouring points.
+/// </summary>
+internal static class MeshRelocate
+{
+    /// <summary>How many alternate locations are tried before the leg is given up.</summary>
+    internal const int Attempts = 5;
+
+    /// <summary>How far from the character an alternate location may be.</summary>
+    internal const double RadiusYd = 50.0;
+
+    /// <summary>Closer than this is the same spot as far as being stuck is concerned.</summary>
+    private const double MinDistanceYd = 10.0;
+
+    /// <summary>A new location must be at least this far from every one already tried.</summary>
+    private const double MinSeparationYd = 12.0;
+
+    private const int SamplesPerPick = 40;
+    private const int MaxCandidates = 12;
+    private const int MaxPathChecks = 6;
+
+    /// <summary>
+    /// Smallest distance from (x, y) to any point in <paramref name="tried"/>, capped at
+    /// <paramref name="cap"/>. With nothing tried yet every point scores the cap.
+    /// </summary>
+    internal static double SpreadScore(double x, double y, IList<RoutePoint> tried, double cap)
+    {
+        double best = cap;
+        for (int i = 0; i < tried.Count; i++)
+        {
+            double d = ClickAimMath.Len(x - tried[i].X, y - tried[i].Y);
+            if (d < best) best = d;
+        }
+        return best;
+    }
+
+    private static bool Finite(Vector3 v)
+        => float.IsFinite(v.X) && float.IsFinite(v.Y) && float.IsFinite(v.Z);
+
+    /// <summary>
+    /// Finds one alternate location within <see cref="RadiusYd"/> of the character.
+    /// <paramref name="excluded"/> says whether an X/Y lies in a profile blackspot.
+    /// Returns false when the mesh offers nothing new, which is a reason to stop.
+    /// </summary>
+    internal static bool TryPick(uint map, IList<RoutePoint> tried, Func<double, double, bool> excluded,
+                                 out RoutePoint point)
+    {
+        point = new RoutePoint();
+        if (ClickAimAbort.Requested || !ClickAimPositions.TryRead(out double x, out double y)) return false;
+        double z = ClickAimPositions.Z();
+        if (!double.IsFinite(z)) return false;
+
+        try
+        {
+            var nav = Navigator.TripperNavigator;
+            if (!nav.IsLoaded) return false;
+
+            var at = new Vector3((float)x, (float)y, (float)z);
+            nav.EnsureTilesAroundPosition(map, at, Navigator.LoadTilesAroundRadius);
+            if (!nav.FindNearestPolyRef(map, at, 2.5f, 5f, out Tripper.Navigation.PolygonReference current, out Vector3 from)
+                || !current.IsValid || !Finite(from)
+                || ClickAimMath.Len(from.X - x, from.Y - y) > 2.5 || Math.Abs(from.Z - z) > 5)
+            {
+                Logging.Write("[Relocate] the character is not on a verified mesh polygon; cannot choose another location");
+                return false;
+            }
+
+            var found = new List<(Vector3 Point, double Score)>();
+            for (int i = 0; i < SamplesPerPick && found.Count < MaxCandidates && !ClickAimAbort.Requested; i++)
+            {
+                if (!nav.FindRandomPoint(map, from, (float)RadiusYd, out Vector3 next) || !Finite(next)) continue;
+
+                double distance = ClickAimMath.Len(next.X - x, next.Y - y);
+                if (distance < MinDistanceYd || distance > RadiusYd + 2.0) continue;
+
+                if (!nav.FindNearestPolyRef(map, next, 0.5f, 2f, out Tripper.Navigation.PolygonReference end, out Vector3 snap)
+                    || !end.IsValid || !Finite(snap)
+                    || ClickAimMath.Len(snap.X - next.X, snap.Y - next.Y) > 0.5
+                    || Math.Abs(snap.Z - next.Z) > 2.0
+                    || (nav.GetPolyArea(map, end, out byte area) & 0x80000000U) != 0
+                    || !MeshRoam.SafeDestinationArea(area)) continue;
+
+                if (excluded != null && excluded(snap.X, snap.Y)) continue;
+
+                double score = SpreadScore(snap.X, snap.Y, tried, RadiusYd);
+                if (tried.Count > 0 && score < MinSeparationYd) continue;
+
+                bool duplicate = false;
+                foreach (var other in found)
+                    if (ClickAimMath.Len(snap.X - other.Point.X, snap.Y - other.Point.Y) < 6.0) { duplicate = true; break; }
+                if (duplicate) continue;
+
+                found.Add((snap, score));
+            }
+
+            // Furthest from everything already tried first: five different directions.
+            found.Sort((a, b) => b.Score.CompareTo(a.Score));
+
+            int checks = 0;
+            foreach (var candidate in found)
+            {
+                if (ClickAimAbort.Requested || checks++ >= MaxPathChecks) break;
+                var probe = new RoutePoint
+                {
+                    X = candidate.Point.X, Y = candidate.Point.Y, Z = candidate.Point.Z, Kind = "Relocate"
+                };
+                // Same complete-path, endpoint and straight-ray validation the walk itself will use.
+                if (RouteRunner.TryCombatMeshPath(x, y, probe) == null) continue;
+                point = probe;
+                return true;
+            }
+
+            Logging.Write(string.Format(CultureInfo.InvariantCulture,
+                "[Relocate] no reachable mesh location found within {0:F0} yd of ({1:F1}, {2:F1}) "
+                + "({3} candidate(s) sampled, {4} already tried)", RadiusYd, x, y, found.Count, tried.Count));
+            return false;
+        }
+        catch (Exception ex)
+        {
+            Logging.Write("[Relocate] mesh sampling failed: " + ex.Message);
+            return false;
+        }
+    }
+
+    internal static string SelfTest()
+    {
+        var tried = new List<RoutePoint>
+        {
+            new RoutePoint { X = 0, Y = 0 },
+            new RoutePoint { X = 30, Y = 0 }
+        };
+        bool ok = SpreadScore(5, 0, new List<RoutePoint>(), 50.0) == 50.0
+               && Math.Abs(SpreadScore(5, 0, tried, 50.0) - 5.0) < 1e-9
+               && Math.Abs(SpreadScore(15, 40, tried, 50.0) - 42.72) < 0.01
+               && SpreadScore(200, 200, tried, 50.0) == 50.0;
+        return "[Relocate] spread-score fixtures: " + (ok ? "pass" : "FAIL") + " (not a live mesh test)";
+    }
+}
diff --git a/Styx/Logic/Pathing/ClickAim/MeshRoam.cs b/Styx/Logic/Pathing/ClickAim/MeshRoam.cs
index a1c6427..344582c 100644
--- a/Styx/Logic/Pathing/ClickAim/MeshRoam.cs
+++ b/Styx/Logic/Pathing/ClickAim/MeshRoam.cs
@@ -33,7 +33,7 @@ internal sealed class MeshRoam
 
     // Area 0 is emitted by our legacy grid-to-mmap builder; native ground and
     // road are 1 and 4. Do not intentionally choose water, lava or portals.
-    private static bool SafeDestinationArea(byte area)
+    internal static bool SafeDestinationArea(byte area)
         => area == 0 || area == (byte)Tripper.Navigation.AreaType.Ground
            || area == (byte)Tripper.Navigation.AreaType.Road;
 
