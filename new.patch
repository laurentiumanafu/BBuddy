+      Say '[P1] VERDICT: foreign threads DO execute calls we point them at (this rung is proven)'
+    } elseif ($ec -eq 0) {
+      Say '[P1] VERDICT: the thread exited with 0 = it never ran our start address'
+    } else {
+      Say '[P1] VERDICT: unexpected exit code - inspect it'
+    }
