+  Say '== [2] bridge skipped: rung [1] is not proven (use -ForceBridge to run it anyway) =='
+} else {
+  Say ''
+  Say '== [2] remote-thread bridge (pushnil, UnitHealth, UnitName) =='
+  $rt = BuildStub $stubHexRT $stubPatchesRT
