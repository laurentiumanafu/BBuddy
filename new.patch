+    $res.stuck = $true
+    $script:stuck = $true
+    $res.why = 'STILL RUNNING'
+    Say ('[' + $tag + '] tid=' + $tid + ' STILL RUNNING after ' + ($timeoutMs / 1000) + ' s  last stage=0x' + ('{0:X}' -f $res.stage) + ' exit=0x103')
