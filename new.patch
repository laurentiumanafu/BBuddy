+  }
+  $E = Get-Qword ($rec + 0x08)
+  if (Test-Pointer $E) {
+    Write-Output ("[{0}] E=0x{1:X} vt=+0x{2:X}" -f $tag, $E, (RvaOf (Get-Qword $E)))
+    Show-Head $E 0x60 ("{0}-E" -f $tag)
