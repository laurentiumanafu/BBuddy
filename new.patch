+}
+
+# ---------------------------------------------------------------- [2] Lua bridge
+Say ''
+Say '== [2] Lua bridge: pushcclosure + pushlstring + pcall =='
+if ($L -eq 0) { Say '[LUA] lua_State is null - log in / enter world, then rerun'; exit 0 }
