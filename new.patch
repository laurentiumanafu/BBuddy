+Say ('[PG] MBI base=0x' + ('{0:X}' -f $m.base) + ' size=0x' + ('{0:X}' -f $m.size) + ' state=0x' + ('{0:X}' -f $m.state) + ' prot=0x' + ('{0:X}' -f $m.prot))
