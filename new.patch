+  if ($sym -eq 'FAKE') { return ($script:pageVA + [uint64]0x100) }
+  if ($sym -eq 'HCOLD') { return ($script:base + $script:coldRva) }
+  if ($sym -like 'RVA:*') { return ($script:base + [uint64][Convert]::ToUInt64($sym.Substring(4), 16)) }
