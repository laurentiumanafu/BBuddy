+# ---------------------------------------------------------------- [3] hijack proof
+$hjProof = $false
+$hjTid = 0
+$hjCand = @()
+if (-not $AllowHJ) {
+  Say ''
+  Say '== [3] hijack ladder skipped (add -AllowHJ to enable; it borrows one idle thread for a few ms) =='
+} elseif (-not $script:execOk) {
