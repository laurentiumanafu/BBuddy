+function WPM([uint64]$addr, [byte[]]$buf) {
+  $wrote = [IntPtr]::Zero
+  if (-not [H38]::WriteProcessMemory($script:hProc, [IntPtr]([int64]$addr), $buf, $buf.Length, [ref]$wrote)) { return $false }
+  return ($wrote.ToInt64() -eq $buf.Length)
