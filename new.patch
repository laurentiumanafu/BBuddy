+  foreach ($t in $threads) {
+    $hh = [H38]::OpenThread(0x40, $false, [uint32]$t)
+    if ($hh -ne [IntPtr]::Zero) {
+      $c1 = [long]0; $e1 = [long]0; $k1 = [long]0; $u1 = [long]0
+      [void][H38]::GetThreadTimes($hh, [ref]$c1, [ref]$e1, [ref]$k1, [ref]$u1)
