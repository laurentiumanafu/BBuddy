+        $hRec++
+      }
+      elseif (($v -eq $unit) -and ($unit -ne 0) -and ($hUnit -lt 6)) {
+        Write-Output ("[WIN] unit pointer @ 0x{0:X} (rec{1}0x{2:X})" -f ($a + [uint64]$i), $(if (($a + [uint64]$i) -ge $rec) { '+' } else { '-' }), [Math]::Abs([int64](($a + [uint64]$i) - $rec)))
+        $hUnit++
