+$strBytes[0] = [byte][char]'p'; $strBytes[1] = [byte][char]'l'; $strBytes[2] = [byte][char]'a'
+$strBytes[3] = [byte][char]'y'; $strBytes[4] = [byte][char]'e'; $strBytes[5] = [byte][char]'r'
+$wrote = [IntPtr]::Zero
