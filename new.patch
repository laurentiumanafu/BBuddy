+        if ($th -eq [IntPtr]::Zero) { Say ('[COLD] CreateRemoteThread failed err=' + (GetLastErr)) }
+        else {
+          $w = [H41]::WaitForSingleObject($th, 10000)
+          $ec = [uint32]0
+          [void][H41]::GetExitCodeThread($th, [ref]$ec)
