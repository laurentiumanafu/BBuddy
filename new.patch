+  $res.tid = $tid
+  $script:lastTh = $th
+  $w = [H45]::WaitForSingleObject($th, [uint32]$timeoutMs)
+  $ec = [uint32]0
+  [void][H45]::GetExitCodeThread($th, [ref]$ec)
+  $res.exit = $ec
+  if ($w -ne 258) { [void][H45]::CloseHandle($th) }   # a wedged thread keeps its handle (we sample it)
+  $rb = RPM $script:ptrSlot 0x100
+  if ($null -eq $rb) { $res.why = 'block unreadable after the call'; return $res }
+  $res.blk = $rb
+  $res.topB = U64B $rb 0x90
+  $res.topA = U64B $rb 0x68
+  $res.stage = U64B $rb 0x70
+  $pv = U64B $rb 0x98
+  $lo = [int64]($pv -band [int64]0xFFFFFFFF)
+  if ($lo -gt 0x7FFFFFFF) { $lo = $lo - 0x100000000 }
+  $res.pcall = [int]$lo
+  $res.tt1 = [int](U16B $rb 0xA8)
+  $res.v1 = U64B $rb 0xA0
+  $res.tt2 = [int](U16B $rb 0xB8)
+  $res.v2 = U64B $rb 0xB0
