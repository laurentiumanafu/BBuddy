+    $r = BridgeOne ('S' + $i) 0x471A370 $c.f $c.a $c.na $c.nr 0 $false 8000 0 0
+    Say (RenderCall $r 1 ('S' + $i + ' ' + $what))
+    if ($c.nr -eq 2) { Say ('[S' + $i + ']   second result: ' + (RenderCall $r 2 $what)) }
+    if ($r.ok -and $r.pcall -eq 0) { $snapOk++ }
