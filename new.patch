+  } elseif ($res.ok) {
+    Say ('[' + $tag + '] WARNING: top_after=0x' + ('{0:X}' -f $res.topA) + ' but expected 0x' + ('{0:X}' -f $exp) + ' - not touching the stack')
+  }
+  return $res
+}
