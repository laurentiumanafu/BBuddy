+    $ds = RPM ([uint64]$v32) 16
+    if ($null -ne $ds) {
+      $q0 = U64B $ds 0
+      $q1 = U64B $ds 8
+      Say ('[PT] descriptor[0]=0x' + ('{0:X}' -f $q0) + ' [8]=0x' + ('{0:X}' -f $q1) + '   as {base,size}=0x' + ('{0:X}' -f $q0) + '..0x' + ('{0:X}' -f ($q0 + $q1)) + '   as {size,base}=0x' + ('{0:X}' -f $q1) + '..0x' + ('{0:X}' -f ($q1 + $q0)))
