+      $c1 = [long]0; $e1 = [long]0; $k1 = [long]0; $u1 = [long]0
+      [void][H35]::GetThreadTimes($h, [ref]$c1, [ref]$e1, [ref]$k1, [ref]$u1)
+      $samples[$t] = @{ k = $k1; u = $u1; h = $h }
