+                                            if (ok)
+                                            {
+                                                _hijackHow = how;
+                                                _hijackClientRip = clientRip;
+                                                _hijackActive = true;
+                                                took = true;
+                                            }
+                                        }
+                                    }
+                                }
+                            }
+                            finally
+                            {
+                                if (!_hijackActive) ResumeThread(_hijackThread);   // one resume per suspend
+                            }
