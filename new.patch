+    if (([int64](Db $eb $o) -band 0x80000000) -eq 0) { continue }
+    $occ++
+    $rec = Qb $eb ($o + 8)
+    if (-not (Test-Pointer $rec)) { continue }
+    $h = Get-Qword ($rec + 0x00)
+    $unit = Get-Qword ($rec + 0xD8)
+    $E = Get-Qword ($rec + 0x08)
+    $u398 = 0; $u39F = -1; $vt = 0
+    if (Test-Pointer $unit) {
