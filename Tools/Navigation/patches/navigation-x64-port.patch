+	/* Two naming schemes are in the wild, and they do not overlap:
+	 *
+	 *   MaNGOS / cmangos / AzerothCore     mmaps\\\\001.mmap    mmaps\\\\0013232.mmtile
+	 *   TrinityCore (and anything newer)   mmaps\\\\0001.mmap   mmaps\\\\0001_32_32.mmtile
+	 *
+	 * Both are read: the mmap set on disk is whatever that install's extractor wrote. */
+
+	// "<mapid><xx><yy>" or "<mapid>_<xx>_<yy>", .mmtile suffix included.
+	bool parseTileFileName(const string& name, unsigned int mapId, int* x, int* y)
+	{
+		const string suffix = ".mmtile";
+		if (name.size() <= suffix.size() ||
+			name.compare(name.size() - suffix.size(), suffix.size(), suffix) != 0)
+			return false;
+
+		const string stem = name.substr(0, name.size() - suffix.size());
+
+		/* The map id and the tile digits are both numbers, so where the map id ends
+		 * has to come from the shape of the name: a "_" separator, or else the four
+		 * trailing digits of a 7- or 8-character run (3-digit or 4-digit map id). */
+		string mapPart, rest;
+		const size_t underscore = stem.find('_');
+		if (underscore != string::npos)
+		{
+			mapPart = stem.substr(0, underscore);
+			rest = stem.substr(underscore);
+		}
+		else
+		{
+			if (stem.size() != 7 && stem.size() != 8)
+				return false;
+			mapPart = stem.substr(0, stem.size() - 4);
+			rest = stem.substr(stem.size() - 4);
+		}
+		if (mapPart.empty())
+			return false;
+		for (size_t i = 0; i < mapPart.size(); i++)
+		{
+			if (mapPart[i] < '0' || mapPart[i] > '9')
+				return false;
+		}
+		if ((unsigned int)atoi(mapPart.c_str()) != mapId)
+			return false;
+		if (rest.size() == 4 &&
+			rest[0] >= '0' && rest[0] <= '9' && rest[1] >= '0' && rest[1] <= '9' &&
+			rest[2] >= '0' && rest[2] <= '9' && rest[3] >= '0' && rest[3] <= '9')
+		{
+			*x = (rest[0] - '0') * 10 + (rest[1] - '0');
+			*y = (rest[2] - '0') * 10 + (rest[3] - '0');
+			return true;
+		}
+
+		if (rest.size() == 6 && rest[0] == '_' && rest[3] == '_' &&
+			rest[1] >= '0' && rest[1] <= '9' && rest[2] >= '0' && rest[2] <= '9' &&
+			rest[4] >= '0' && rest[4] <= '9' && rest[5] >= '0' && rest[5] <= '9')
+		{
+			*x = (rest[1] - '0') * 10 + (rest[2] - '0');
+			*y = (rest[4] - '0') * 10 + (rest[5] - '0');
+			return true;
+		}
+
+		return false;
+	}
